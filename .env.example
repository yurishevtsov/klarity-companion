# Klarity Companion — environment template
# Copy to .env.local and fill in values. Do NOT commit .env.local.

# InsForge — link first via `npx @insforge/cli link --project-id <id>`.
# Get anon key with: `npx @insforge/cli secrets get ANON_KEY`
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
INSFORGE_APP_KEY=
INSFORGE_REGION=us-east
INSFORGE_PROJECT_ID=

# Zeabur AI Hub (OpenAI-compatible, routes to Claude / Kimi / etc.)
ZEABUR_AI_API_KEY=
ZEABUR_AI_BASE_URL=https://sfo1.aihub.zeabur.ai
ZEABUR_AI_MODEL_CHAT=claude-haiku-4-5
ZEABUR_AI_MODEL_SOAP=claude-sonnet-4-5

# Anthropic Claude (optional fallback if not using Zeabur AI Hub)
ANTHROPIC_API_KEY=

# Retell (outbound Sentinel voice agent). Set after creating an agent in their dashboard.
RETELL_API_KEY=
RETELL_AGENT_ID=
# Number you own in Retell (E.164 format, e.g. +14155551212). Required for outbound phone calls.
RETELL_FROM_NUMBER=

# Demo phone number that Sentinel calls (E.164: +1XXXXXXXXXX)
DEMO_PHONE_NUMBER=

# Public deploy URL — set after Zeabur deploy. Used as Retell webhook destination.
NEXT_PUBLIC_APP_URL=
RETELL_WEBHOOK_URL=
