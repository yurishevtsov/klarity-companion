# Klarity Companion — environment template
# Copy to .env.local and fill in values. Do NOT commit .env.local.

# InsForge (run `npx @insforge/cli link --project-id <id>` to create .insforge/project.json)
INSFORGE_APP_KEY=
INSFORGE_API_KEY=
INSFORGE_OSS_HOST=
INSFORGE_REGION=us-east
INSFORGE_PROJECT_ID=

# Anthropic Claude (Coach replies + SOAP note generation)
ANTHROPIC_API_KEY=

# Retell (outbound Sentinel voice agent)
RETELL_API_KEY=
RETELL_AGENT_ID=

# Demo phone number that Sentinel calls (E.164: +1XXXXXXXXXX)
DEMO_PHONE_NUMBER=

# Public deploy URL — set after Zeabur deploy. Used as Retell webhook destination.
NEXT_PUBLIC_APP_URL=
RETELL_WEBHOOK_URL=
